# Von @BotFather in Telegram erzeugen: /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deine eigene Chat-ID. Herausfinden: Bot anschreiben, dann
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# und in der Antwort message.chat.id ablesen.
# Nur diese Chat-ID darf mit dem Bot reden.
TELEGRAM_CHAT_ID=123456789

# Zeitzone, falls in config/settings.yaml keine steht (die hätte Vorrang).
TZ=Europe/Berlin
